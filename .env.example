# Configurações Gerais do Projeto
PROJECT_NAME="MedSync API"
ENVIRONMENT="development"

# Segurança e JWT (OBRIGATÓRIO, sem valor padrão no código)
# Gere com: openssl rand -hex 32
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de Dados (SQLModel / SQLAlchemy)
DATABASE_URL="sqlite:///./medsync.db"

# Hardening e CORS
ALLOWED_ORIGINS="http://localhost:3000,https://clinica.medsync.com.br"
LOGIN_RATE_LIMIT_PER_MINUTE=5
MFA_RATE_LIMIT_PER_MINUTE=5

# Dados de demonstração (apenas desenvolvimento local)
# Com SEED_DEMO_DATA=true, a senha abaixo é aplicada aos usuários de exemplo
# (admin, dr_roberto, dra_beatriz, recepcao). Defina valores SEUS no .env local.
SEED_DEMO_DATA=false
DEMO_USERS_PASSWORD=
DEMO_LAB_CLIENT_SECRET=
# Segredo TOTP base32 do admin demo (opcional; se vazio, é gerado e impresso no console)
DEMO_ADMIN_MFA_SECRET=
